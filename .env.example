# Optional local tooling paths. Copy to .env.local, which is ignored by Git.
# Without overrides, the scripts use node and flutter from PATH.
# Use shell syntax; this file is sourced by the launch scripts.
# The defaults below preserve values passed through the environment.

# NODE_BIN="${NODE_BIN:-/path/to/node}"
# FLUTTER_BIN="${FLUTTER_BIN:-/path/to/flutter}"
# FLUTTER_USER_HOME="${FLUTTER_USER_HOME:-/path/to/flutter-home}"
# PUB_CACHE="${PUB_CACHE:-/path/to/pub-cache}"

# Cloud settings belong in the hosting dashboard, not in Git.
# Local launch remains SQLite unless DATABASE_URL is set.
# export DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=verify-full"
# export MAYAK_MODE="cloud"
# export PUBLIC_URL="https://YOUR-SERVICE.onrender.com"
# export REGISTRATION_CODE="a-private-invitation-code-at-least-16-characters"
# export TRUST_PROXY="1"

# On Render, PUBLIC_URL is inferred from RENDER_EXTERNAL_HOSTNAME.
# TRUST_PROXY=1 assumes exactly one trusted proxy appends X-Forwarded-For.
